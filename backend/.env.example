# Copy to backend/.env and adjust. All values below are safe local defaults.
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave DATABASE_URL unset to use local SQLite (db.sqlite3).
# For PostgreSQL (per spec): postgres://mhs:mhs@localhost:5432/mhs
# DATABASE_URL=postgres://mhs:mhs@localhost:5432/mhs

# Leave REDIS_URL unset to use the in-memory channel layer + eager Celery (no Redis needed for the demo).
# REDIS_URL=redis://localhost:6379/0

# --- Video / communications (dual-mode) ---
# webrtc  = custom WebRTC with COTURN/STUN signalling over Channels
# managed = managed API (AWS Chime SDK or Twilio Video)
VIDEO_PROVIDER=webrtc
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
MANAGED_VIDEO_VENDOR=twilio
MANAGED_VIDEO_API_KEY=
MANAGED_VIDEO_API_SECRET=

# --- Third-party payment adapters (mock unless keys provided) ---
MPESA_ENV=mock
AIRTEL_MONEY_ENV=mock
STRIPE_SECRET_KEY=

# --- Telecom gateway ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
USSD_ADAPTER=mock
